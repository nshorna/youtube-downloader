# Copy to .env.development / .env.production and fill in real values.
# Never commit real secrets.

# Database (PostgreSQL)
DATABASE_URL=postgresql://ytdl_user:CHANGE_ME@localhost:5432/ytdl_dev
DB_USER=ytdl_user
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ytdl_dev

# Firebase Admin — paste the FULL service account JSON as a single-line string
# (Project Settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"REPLACE","private_key":"REPLACE","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"REPLACE","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Firebase Web client (public keys — still prefer env over hardcoding)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Firebase Cloud Messaging VAPID key
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Public site URL (SEO / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3021

# Optional analytics
# NEXT_PUBLIC_MS_CLARITY_PROJECT_ID=

# yt-dlp cookies (server path to cookies.txt)
YTDLP_COOKIES_FILE=/home/YOUR_USER/.config/yt-dlp/cookies.txt
