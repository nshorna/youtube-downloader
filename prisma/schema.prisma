generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DownloadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Download {
  id              String         @id @default(uuid())
  url             String
  formatId        String
  videoId         String?
  videoTitle      String
  formatResolution String
  formatExt       String
  status          DownloadStatus @default(PENDING)
  filePath        String?
  fileName        String?
  error           String?
  progress        Float?         @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([formatId, videoId])
}